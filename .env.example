# Docker Compose 本地配置。公开部署前必须替换所有示例值。
APP_IMAGE_TAG=local
MYSQL_ROOT_PASSWORD=change-this-mysql-password
REDIS_PASSWORD=change-this-redis-password
AI_API_SHARED_JWT_SECRET=change-this-to-a-random-string-at-least-32-characters
CORS_ALLOWED_ORIGINS=http://localhost
CLINICAL_ZONE=Asia/Shanghai
SPRING_PROFILES_ACTIVE=dev

# 网络受限时可替换基础镜像仓库和软件源。
DOCKER_BASE_IMAGE_REGISTRY=public.ecr.aws/docker/library
DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
